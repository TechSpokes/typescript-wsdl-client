{
  "name": "@techspokes/typescript-wsdl-client",
  "version": "1.15.0",
  "description": "Turn legacy WSDL/SOAP services into typed TypeScript clients, OpenAPI 3.1 specs, and production-ready Fastify REST gateways. Built for enterprise SOAP modernization.",
  "keywords": [
    "wsdl",
    "soap",
    "typescript",
    "openapi",
    "rest",
    "gateway",
    "fastify",
    "codegen",
    "soap-to-rest",
    "api-gateway",
    "code-generator",
    "wsdl-to-typescript",
    "soap-modernization",
    "wsdl-parser",
    "soap-to-rest-bridge",
    "legacy-api"
  ],
  "homepage": "https://github.com/TechSpokes/typescript-wsdl-client#readme",
  "bugs": {
    "url": "https://github.com/TechSpokes/typescript-wsdl-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechSpokes/typescript-wsdl-client.git"
  },
  "license": "MIT",
  "author": "TechSpokes <contact@techspokes.com> (https://www.techspokes.com)",
  "contributors": [
    "Serge Liatko <contact@techspokes.com> (https://github.com/sergeliatko)"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "wsdl-tsc": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/runtime/**",
    "dist/runtime/jsonArray.js",
    "dist/runtime/ndjson.js",
    "docs/README.md",
    "docs/start-here.md",
    "docs/cli-reference.md",
    "docs/configuration.md",
    "docs/concepts.md",
    "docs/generated-code.md",
    "docs/output-anatomy.md",
    "docs/gateway-guide.md",
    "docs/checked-generation.md",
    "docs/checked-gateway.md",
    "docs/checked-streaming.md",
    "docs/supported-patterns.md",
    "docs/troubleshooting.md",
    "docs/migration.md",
    "docs/migration-playbook.md",
    "docs/production.md",
    "docs/testing.md",
    "docs/api-reference.md",
    "docs/agent-skill.md",
    "docs/direct-values.md",
    "docs/mapping-contract.md",
    "docs/corpus.md",
    "docs/examples/**",
    "README.md",
    "LICENSE",
    "llms.txt",
    "src/runtime/streamXml.ts",
    "src/util/upstreamSecurity.ts",
    "src/util/upstreamSecurityTypes.ts",
    "src/runtime/*.tpl.txt",
    "src/generation/preambles/**/*.preamble"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "watch": "tsx watch src/cli.ts",
    "clean": "rimraf dist",
    "clean:verification": "tsx scripts/run-verification.ts recover",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "typecheck:integration": "tsc -p test/integration/tsconfig.json",
    "test": "tsx scripts/run-verification.ts test:run",
    "test:run": "vitest run",
    "test:unit": "tsx scripts/run-verification.ts test:unit:run",
    "test:unit:run": "vitest run test/unit",
    "test:snap": "vitest run test/snapshot",
    "test:integration": "tsx scripts/run-verification.ts test:integration:run",
    "test:integration:run": "vitest run test/integration",
    "test:feasibility": "vitest run test/integration/content-model-soap-feasibility.test.ts test/integration/content-model-gateway-feasibility.test.ts",
    "test:installed": "tsx scripts/run-verification.ts test:installed:run",
    "test:installed:run": "vitest run installed.test.ts",
    "test:platform": "vitest run test/conformance/soap-receiver.test.ts test/integration/direct-normal-execution.test.ts test/integration/noaa-ndfd-qualification.test.ts test/integration/owned-node-process.test.ts test/integration/component-soap12.test.ts test/integration/component-soap.test.ts test/integration/component-service-headers.test.ts test/integration/checked-atomic-unions.test.ts test/integration/checked-union-lists.test.ts test/unit test/tooling test/integration/client-imports.test.ts test/integration/content-model-soap-feasibility.test.ts test/integration/content-model-gateway-feasibility.test.ts test/integration/verification-owner.test.ts",
    "test:conformance": "tsx scripts/run-verification.ts test:conformance:run",
    "test:conformance:run": "vitest run test/conformance --reporter=verbose",
    "test:conformance:contracts": "vitest run --config vitest.conformance.config.ts test/conformance/stages/contracts.stage.ts --reporter=verbose",
    "test:conformance:compile": "vitest run --config vitest.conformance.config.ts test/conformance/stages/compile.stage.ts --reporter=verbose",
    "test:conformance:client": "vitest run --config vitest.conformance.config.ts test/conformance/stages/client.stage.ts --reporter=verbose",
    "test:conformance:openapi": "vitest run --config vitest.conformance.config.ts test/conformance/stages/openapi.stage.ts --reporter=verbose",
    "test:conformance:gateway": "vitest run --config vitest.conformance.config.ts test/conformance/stages/gateway.stage.ts --reporter=verbose",
    "test:conformance:generated-tests": "vitest run --config vitest.conformance.config.ts test/conformance/stages/generated-tests.stage.ts --reporter=verbose",
    "test:conformance:app": "vitest run --config vitest.conformance.config.ts test/conformance/stages/app.stage.ts --reporter=verbose",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build && npm run package:validate",
    "smoke:pipeline": "tsx scripts/run-verification.ts smoke:pipeline:run",
    "smoke:pipeline:run": "tsx scripts/smoke-pipeline.ts",
    "maint:deps": "node scripts/maint-deps.mjs",
    "docs:support-matrix": "tsx scripts/generate-support-matrix.ts",
    "docs:support-matrix:check": "tsx scripts/generate-support-matrix.ts --check",
    "docs:corpus": "tsx scripts/product-corpus.ts",
    "docs:corpus:check": "tsx scripts/product-corpus.ts --check",
    "test:corpus": "tsx scripts/run-verification.ts test:corpus:run",
    "test:corpus:run": "npm run build && npm run package:validate -- --pack && tsx scripts/product-corpus.ts --test",
    "docs:validate": "node scripts/validate-docs.mjs && npm run docs:support-matrix:check && npm run docs:corpus:check",
    "skill:validate": "node scripts/validate-agent-skill.mjs",
    "skill:package": "node scripts/build-agent-skill.mjs",
    "package:validate": "tsx scripts/validate-npm-package.ts",
    "verify:onvif-media": "tsx scripts/qualify-onvif-media.ts",
    "package:smoke": "tsx scripts/run-verification.ts package:smoke:run",
    "package:smoke:run": "tsx scripts/smoke-npm-package.ts",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:publish-check": "npm run clean && npm run build && npm run typecheck && npm run skill:validate && npm run package:validate --",
    "ci": "tsx scripts/run-verification.ts ci:run",
    "ci:run": "npm run check:toolchain && npm run typecheck:tooling && npm run typecheck:reference && npm run build && npm run test:reference:run && npm run typecheck:integration && npm run skill:validate && npm run package:validate -- --pack && npm run docs:validate && vitest run --exclude \"test/conformance/reference/**\" && npm run smoke:pipeline:run && npm run package:smoke:run",
    "ci:platform": "tsx scripts/run-verification.ts ci:platform:run --tags-filter installed-compatibility",
    "ci:platform:full": "tsx scripts/run-verification.ts ci:platform:run",
    "ci:platform:run": "npm run build && npm run package:validate -- --pack && npm run test:reference:run && npm run test:platform && npm run package:smoke:run && npm run test:installed:run --",
    "examples:regenerate": "tsx src/cli.ts pipeline --wsdl-source examples/minimal/weather.wsdl --client-dir examples/generated-output/client --openapi-file examples/generated-output/openapi.json --gateway-dir examples/generated-output/gateway --gateway-service-name weather --gateway-version-prefix v1 --openapi-format json",
    "reference:setup": "tsx scripts/semantic-reference.ts --setup",
    "test:reference": "tsx scripts/run-verification.ts test:reference:run",
    "test:reference:run": "tsx scripts/semantic-reference.ts",
    "test:reference:full": "tsx scripts/semantic-reference.ts --full",
    "check:toolchain": "tsx scripts/check-toolchain.ts",
    "typecheck:tooling": "tsc -p test/tooling/tsconfig.json",
    "research:typecheck": "tsc -p research/tsconfig.json",
    "typecheck:reference": "tsc -p test/conformance/reference/tsconfig.json",
    "research:test": "tsx research/reference/run.ts",
    "research:reference": "tsx research/reference/run.ts --reference-only",
    "research:docs": "tsx research/validate-docs.ts",
    "research:ci": "npm run check:toolchain && npm run research:typecheck && npm run research:docs && npm run research:test",
    "research:re01:measure": "tsx research/tests/re01/measure.ts",
    "research:re01:compare": "tsx research/tests/re01/cli.ts",
    "assess:inventory": "tsx scripts/readiness-inventory.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.15.0",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "libxml2-wasm": "^0.7.2",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "fast-xml-parser": "^5.12.1",
    "js-yaml": "^5.5.0",
    "saxes": "^6.0.0",
    "soap": "^1.14.1",
    "yargs": "^18.2.0"
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "rimraf": {
      "glob": "^14.0.3"
    }
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/TechSpokes"
  }
}
