<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:re01:abstract-fixed" targetNamespace="urn:re01:abstract-fixed">
  <xs:attribute name="g" type="xs:int"/>
  <xs:complexType name="A"><xs:attribute ref="t:g" fixed="1"/></xs:complexType>
  <xs:complexType name="B">
    <xs:complexContent><xs:restriction base="t:A"><xs:attribute ref="t:g" use="prohibited"/></xs:restriction></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="D">
    <xs:complexContent><xs:extension base="t:B"><xs:attribute ref="t:g" fixed="2"/></xs:extension></xs:complexContent>
  </xs:complexType>
  <xs:element name="root" type="t:D"/>
</xs:schema>
