<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:t="urn:re01" targetNamespace="urn:re01" elementFormDefault="qualified">
  <xs:complexType name="A"/>
  <xs:complexType name="E">
    <xs:complexContent>
      <xs:extension base="t:A">
        <xs:choice minOccurs="0" maxOccurs="unbounded">
          <xs:element name="a" type="xs:string"/>
          <xs:element name="b" type="xs:string"/>
        </xs:choice>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="B">
    <xs:complexContent>
      <xs:restriction base="t:E">
        <xs:sequence minOccurs="17" maxOccurs="17">
          <xs:element name="a" type="xs:string"/>
          <xs:element name="b" type="xs:string"/>
        </xs:sequence>
      </xs:restriction>
    </xs:complexContent>
  </xs:complexType>
  <xs:complexType name="D">
    <xs:complexContent><xs:extension base="t:B"/></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="UniversalWitness">
    <xs:complexContent>
      <xs:extension base="t:A">
        <xs:sequence><xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/></xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element name="root" type="t:D"/>
</xs:schema>
