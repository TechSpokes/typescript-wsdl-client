<?xml version="1.0" encoding="utf-8"?>
<wsdl:definitions xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:tns="urn:companion-scoped-identities"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema"
                  targetNamespace="urn:companion-scoped-identities">
  <wsdl:types>
    <xs:schema elementFormDefault="qualified" targetNamespace="urn:companion-scoped-identities">
      <xs:complexType name="Service">
        <xs:sequence><xs:element name="CompanionOnly" type="xs:string"/></xs:sequence>
      </xs:complexType>
      <xs:complexType name="FirstOwner">
        <xs:sequence><xs:element name="Service"><xs:complexType>
          <xs:sequence><xs:element name="FirstOnly" type="xs:string"/></xs:sequence>
        </xs:complexType></xs:element></xs:sequence>
      </xs:complexType>
      <xs:complexType name="SecondOwner">
        <xs:sequence><xs:element name="Service"><xs:complexType>
          <xs:sequence><xs:element name="SecondOnly" type="xs:string"/></xs:sequence>
        </xs:complexType></xs:element></xs:sequence>
      </xs:complexType>
      <xs:element name="Request" type="xs:string"/>
      <xs:element name="Response" type="xs:string"/>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="Input"><wsdl:part name="parameters" element="tns:Request"/></wsdl:message>
  <wsdl:message name="Output"><wsdl:part name="parameters" element="tns:Response"/></wsdl:message>
  <wsdl:portType name="Port">
    <wsdl:operation name="Read"><wsdl:input message="tns:Input"/><wsdl:output message="tns:Output"/></wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="Binding" type="tns:Port">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="Read">
      <soap:operation soapAction="urn:read"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="ServiceWsdl">
    <wsdl:port name="Port" binding="tns:Binding"><soap:address location="http://example.test/scoped"/></wsdl:port>
  </wsdl:service>
</wsdl:definitions>
