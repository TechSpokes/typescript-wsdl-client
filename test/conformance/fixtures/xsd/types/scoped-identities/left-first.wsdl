<?xml version="1.0" encoding="utf-8"?>
<wsdl:definitions xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
                  xmlns:tns="urn:scoped-identities"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:xs="http://www.w3.org/2001/XMLSchema"
                  targetNamespace="urn:scoped-identities">
  <wsdl:types>
    <xs:schema elementFormDefault="qualified" targetNamespace="urn:scoped-identities">
      <xs:complexType name="BaseLeft">
        <xs:attribute name="BaseLeft" type="xs:string"/>
      </xs:complexType>
      <xs:complexType name="BaseRight">
        <xs:attribute name="BaseRight" type="xs:string"/>
      </xs:complexType>
      <xs:complexType name="FooBar">
        <xs:sequence><xs:element name="NamedOnly" type="xs:string"/></xs:sequence>
      </xs:complexType>
      <xs:element name="FooBar" type="tns:FooBar"/>
      <xs:complexType name="RecursiveNode">
        <xs:sequence>
          <xs:element name="Value" type="xs:string"/>
          <xs:element name="Next" type="tns:RecursiveNode" minOccurs="0"/>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Left">
        <xs:sequence>
          <xs:element name="Entry">
            <xs:complexType>
              <xs:sequence><xs:element name="LeftOnly" type="xs:string"/></xs:sequence>
              <xs:attribute name="Quantity" type="xs:integer"/>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="Right">
        <xs:sequence>
          <xs:element name="Entry">
            <xs:complexType>
              <xs:sequence><xs:element name="RightOnly" type="xs:string"/></xs:sequence>
              <xs:attribute name="Quantity" type="xs:nonNegativeInteger"/>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="InheritedLeft">
        <xs:sequence>
          <xs:element name="Entry">
            <xs:complexType>
              <xs:complexContent>
                <xs:extension base="tns:BaseLeft">
                  <xs:sequence><xs:element name="LeftOnly" type="xs:string"/></xs:sequence>
                </xs:extension>
              </xs:complexContent>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="InheritedRight">
        <xs:sequence>
          <xs:element name="Entry">
            <xs:complexType>
              <xs:complexContent>
                <xs:extension base="tns:BaseRight">
                  <xs:sequence><xs:element name="RightOnly" type="xs:string"/></xs:sequence>
                </xs:extension>
              </xs:complexContent>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="NestedParent">
        <xs:sequence>
          <xs:element name="Entry">
            <xs:complexType>
              <xs:sequence>
                <xs:element name="Entry">
                  <xs:complexType>
                    <xs:sequence><xs:element name="Leaf" type="xs:string"/></xs:sequence>
                  </xs:complexType>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="StableOwner">
        <xs:sequence>
          <xs:element name="Details">
            <xs:complexType>
              <xs:sequence><xs:element name="Code" type="xs:string"/></xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:complexType name="NormalizedOwner">
        <xs:sequence>
          <xs:element name="foo-bar">
            <xs:complexType>
              <xs:sequence><xs:element name="AnonymousOnly" type="xs:string"/></xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
      </xs:complexType>
      <xs:element name="Request" type="xs:string"/>
      <xs:element name="Response" type="xs:string"/>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="Input"><wsdl:part name="parameters" element="tns:Request"/></wsdl:message>
  <wsdl:message name="Output"><wsdl:part name="parameters" element="tns:Response"/></wsdl:message>
  <wsdl:portType name="Port">
    <wsdl:operation name="Read"><wsdl:input message="tns:Input"/><wsdl:output message="tns:Output"/></wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="Binding" type="tns:Port">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="Read">
      <soap:operation soapAction="urn:read"/>
      <wsdl:input><soap:body use="literal"/></wsdl:input>
      <wsdl:output><soap:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="Service">
    <wsdl:port name="Port" binding="tns:Binding"><soap:address location="http://example.test/scoped"/></wsdl:port>
  </wsdl:service>
</wsdl:definitions>
