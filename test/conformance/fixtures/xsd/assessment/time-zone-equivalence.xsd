<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:review" targetNamespace="urn:review">
  <xs:simpleType name="T">
    <xs:restriction base="xs:time">
      <xs:enumeration value="23:00:00Z"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="v" type="t:T" default="01:00:00+02:00"/>
  <xs:complexType name="D">
    <xs:sequence>
      <xs:element ref="t:v"/>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="root" type="t:D"/>
</xs:schema>
