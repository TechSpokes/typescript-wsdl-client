<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:graph" xmlns:q="urn:qname"
  targetNamespace="urn:graph" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:annotation><xs:appinfo>before<q:note plain="1" q:code="2"/>after</xs:appinfo></xs:annotation>
  <xs:group name="Pair"><xs:sequence><xs:element name="a" type="xs:string"/><xs:element name="b" type="xs:int"/></xs:sequence></xs:group>
  <xs:attribute name="Shared" type="xs:QName" default="q:Default"/>
  <xs:attributeGroup name="Flags"><xs:attribute ref="t:Shared"/><xs:anyAttribute namespace="##other" processContents="lax"/></xs:attributeGroup>
  <xs:simpleType name="Exact"><xs:restriction base="xs:decimal"><xs:pattern value="[+]0[0-9][.][0-9]{2}"/><xs:minInclusive value="+01.00" fixed="true"/><xs:fractionDigits value="2"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Names"><xs:restriction base="xs:QName"><xs:enumeration xmlns:q="urn:rebound" value="q:Name"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Items"><xs:list itemType="t:Exact"/></xs:simpleType>
  <xs:simpleType name="Alternatives"><xs:union memberTypes="t:Exact xs:string"><xs:simpleType><xs:restriction base="xs:boolean"/></xs:simpleType></xs:union></xs:simpleType>
  <xs:complexType name="Shared" mixed="true">
    <xs:sequence xml:base="nested/">
      <xs:group ref="t:Pair" minOccurs="0" maxOccurs="2"/>
      <xs:choice minOccurs="1" maxOccurs="3"><xs:element name="local" type="t:Exact" default="+01.00"/><xs:any namespace="##other" processContents="skip"/></xs:choice>
      <xs:group ref="t:Pair" minOccurs="3" maxOccurs="900719925474099312345678901234567890"/>
      <xs:element ref="t:Shared" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="inline" form="unqualified"><xs:complexType><xs:sequence><xs:element name="child" type="t:Shared" minOccurs="0"/></xs:sequence><xs:attribute name="id" type="xs:string" fixed="007"/></xs:complexType></xs:element>
    </xs:sequence>
    <xs:attributeGroup ref="t:Flags"/>
    <xs:attribute name="id" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:element name="Shared" type="t:Shared" nillable="true"/>
  <xs:complexType name="Other"><xs:all minOccurs="0"><xs:element name="local" type="xs:boolean" minOccurs="0"/></xs:all></xs:complexType>
  <xs:complexType name="Extended" mixed="true"><xs:complexContent><xs:extension base="t:Shared"><xs:sequence><xs:element name="extra" type="xs:string"/></xs:sequence><xs:attribute name="tag" type="xs:string"/></xs:extension></xs:complexContent></xs:complexType>
  <xs:complexType name="ScalarBase"><xs:simpleContent><xs:extension base="t:Exact"><xs:attribute name="id" type="xs:string"/></xs:extension></xs:simpleContent></xs:complexType>
  <xs:complexType name="Restricted"><xs:simpleContent><xs:restriction base="t:ScalarBase"><xs:pattern value="[+]01[.]00"/><xs:attribute name="id" use="prohibited"/></xs:restriction></xs:simpleContent></xs:complexType>
</xs:schema>
