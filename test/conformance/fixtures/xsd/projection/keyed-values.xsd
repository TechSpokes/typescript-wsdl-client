<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:m="urn:keyed-values" xmlns:k="urn:keyed-known" targetNamespace="urn:keyed-values" elementFormDefault="qualified">
  <xs:import namespace="urn:keyed-known" schemaLocation="keyed-known.xsd"/>
  <xs:complexType name="Paragraph" mixed="true">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="b" type="xs:string"/>
      <xs:element name="p" type="m:Paragraph" nillable="true"/>
    </xs:choice>
    <xs:attribute name="id" type="xs:string"/>
  </xs:complexType>
  <xs:element name="p" type="m:Paragraph"/>
  <xs:complexType name="Open"><xs:sequence>
    <xs:element name="count" type="xs:int"/>
    <xs:any namespace="##other" processContents="lax" minOccurs="1" maxOccurs="unbounded"/>
  </xs:sequence></xs:complexType>
  <xs:element name="open" type="m:Open"/>
  <xs:element name="skip"><xs:complexType><xs:sequence><xs:any namespace="##other" processContents="skip" maxOccurs="unbounded"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="strict"><xs:complexType><xs:sequence><xs:any namespace="##other" processContents="strict" maxOccurs="unbounded"/></xs:sequence></xs:complexType></xs:element>
  <xs:element name="collision"><xs:complexType><xs:sequence><xs:element name="code" type="xs:string"/></xs:sequence>
    <xs:attribute name="code" type="xs:string" form="qualified" use="required"/>
  </xs:complexType></xs:element>
  <xs:element name="names"><xs:complexType><xs:choice minOccurs="0" maxOccurs="unbounded">
    <xs:element name="code" type="xs:string" nillable="true"/><xs:element ref="k:code"/>
  </xs:choice></xs:complexType></xs:element>
  <xs:element name="fixedNames"><xs:complexType mixed="true"><xs:sequence>
    <xs:element name="code" type="xs:string"/><xs:element ref="k:code"/>
  </xs:sequence></xs:complexType></xs:element>
</xs:schema>
