<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:restricted-scalars" targetNamespace="urn:restricted-scalars" elementFormDefault="qualified">
  <xs:simpleType name="Target"><xs:restriction base="xs:string"><xs:enumeration value="Test"/><xs:enumeration value="Production"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Code"><xs:restriction base="xs:token"><xs:length value="4"/><xs:pattern value="[A-Z]{2}[0-9]{2}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="AliasCode"><xs:restriction base="t:Code"><xs:pattern value="AB[0-9]{2}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Money"><xs:restriction base="xs:decimal"><xs:totalDigits value="5"/><xs:fractionDigits value="2"/><xs:minInclusive value="0"/><xs:maxExclusive value="1000"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="SmallInt"><xs:restriction base="xs:int"><xs:minInclusive value="1"/><xs:maxInclusive value="3"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="List"><xs:list itemType="xs:string"/></xs:simpleType>
  <xs:simpleType name="Union"><xs:union memberTypes="xs:boolean xs:int"/></xs:simpleType>
  <xs:complexType name="Record"><xs:sequence><xs:element name="Code" type="t:AliasCode"/><xs:element name="Money" type="t:Money"/><xs:element name="Count" type="t:SmallInt"/></xs:sequence><xs:attribute name="Target" type="t:Target" default="Test"/><xs:attribute name="FixedCode" type="t:AliasCode" fixed="AB12"/></xs:complexType>
  <xs:complexType name="FlatRecord"><xs:sequence><xs:element name="Code" type="t:Target"/></xs:sequence></xs:complexType>
  <xs:element name="Request" type="t:Record"/>
  <xs:element name="Scalar" type="t:AliasCode"/>
  <xs:element name="FlatRecord" type="t:FlatRecord"/>
  <xs:element name="List" type="t:List"/>
  <xs:element name="Union" type="t:Union"/>
</xs:schema>
