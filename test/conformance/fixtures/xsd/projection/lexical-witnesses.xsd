<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:lexical-witnesses" targetNamespace="urn:lexical-witnesses" elementFormDefault="qualified">
  <xs:simpleType name="Decimal"><xs:restriction base="xs:decimal"><xs:pattern value="[+]0[0-9][.][0-9]{2}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Int"><xs:restriction base="xs:int"><xs:pattern value="[+]00[0-9]"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Bool"><xs:restriction base="xs:boolean"><xs:pattern value="1"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Hex"><xs:restriction base="xs:hexBinary"><xs:pattern value="[a-f]{4}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Binary"><xs:restriction base="xs:base64Binary"><xs:pattern value="A Q I ="/></xs:restriction></xs:simpleType>
  <xs:complexType name="Record"><xs:sequence>
    <xs:element name="Decimal" type="t:Decimal"/><xs:element name="Int" type="t:Int"/><xs:element name="Bool" type="t:Bool"/>
    <xs:element name="Hex" type="t:Hex"/><xs:element name="Binary" type="t:Binary"/>
  </xs:sequence><xs:attribute name="A" type="t:Int" fixed="+007"/></xs:complexType>
  <xs:element name="Request" type="t:Record"/>
</xs:schema>
