<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:simple-content-records" targetNamespace="urn:simple-content-records" elementFormDefault="qualified">
  <xs:simpleType name="Code"><xs:restriction base="xs:token"><xs:pattern value="[A-Z]{2}[0-9]{2}"/></xs:restriction></xs:simpleType>
  <xs:complexType name="Text"><xs:simpleContent><xs:extension base="t:Code"><xs:attribute name="id" type="xs:string"/><xs:attribute name="lang" type="xs:language" default="en"/></xs:extension></xs:simpleContent></xs:complexType>
  <xs:complexType name="Derived"><xs:simpleContent><xs:extension base="t:Text"><xs:attribute name="priority" type="xs:int"/></xs:extension></xs:simpleContent></xs:complexType>
  <xs:complexType name="Number"><xs:simpleContent><xs:extension base="xs:decimal"><xs:attribute name="Currency" type="xs:string" fixed="USD"/></xs:extension></xs:simpleContent></xs:complexType>
  <xs:complexType name="Message"><xs:sequence><xs:element name="Item" type="t:Derived" minOccurs="0" maxOccurs="unbounded"/><xs:element name="Amount" type="t:Number"/></xs:sequence></xs:complexType>
  <xs:element name="Request" type="t:Message"/>
  <xs:element name="Text" type="t:Derived"/>
  <xs:element name="Number" type="t:Number"/>
</xs:schema>
