<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:fresh-source-middle:empty" targetNamespace="urn:fresh-source-middle:empty">
  <xs:complexType name="A"><xs:attribute name="currency" type="xs:string" use="required"/></xs:complexType>
  <xs:complexType name="B"><xs:complexContent><xs:extension base="t:A">
    <xs:sequence><xs:element name="reason" type="xs:string" minOccurs="0"/></xs:sequence>
    <xs:attribute name="discount" type="xs:decimal"/>
  </xs:extension></xs:complexContent></xs:complexType>
  <xs:complexType name="D"><xs:complexContent><xs:extension base="t:B">
    <xs:attribute name="advance" type="xs:duration"/>
  </xs:extension></xs:complexContent></xs:complexType>
  <xs:element name="Record" type="t:D"/>
</xs:schema>
