<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:private:inherited" targetNamespace="urn:private:inherited" elementFormDefault="qualified">
  <xs:simpleType name="Item"><xs:union memberTypes="xs:QName xs:boolean"/></xs:simpleType>
  <xs:simpleType name="Words"><xs:list itemType="t:Item"/></xs:simpleType>
  <xs:simpleType name="HeadWords"><xs:restriction base="t:Words"><xs:pattern value="true"/></xs:restriction></xs:simpleType>
  <xs:element name="h1" type="t:HeadWords" abstract="true"/>
  <xs:element name="h2" type="t:HeadWords" abstract="true"/>
  <xs:complexType name="A"><xs:complexContent><xs:restriction base="xs:anyType"><xs:choice>
    <xs:element name="y1" type="t:Words" minOccurs="0" fixed="1"/>
    <xs:element name="y2" type="t:Words" minOccurs="0" fixed="true"/>
  </xs:choice></xs:restriction></xs:complexContent></xs:complexType>
  <xs:complexType name="R"><xs:complexContent><xs:restriction base="t:A"/></xs:complexContent></xs:complexType>
  <xs:complexType name="OffA"><xs:complexContent><xs:restriction base="xs:anyType"><xs:choice>
    <xs:element name="y1" type="t:Words" minOccurs="0" fixed="0"/>
    <xs:element name="y2" type="t:Words" minOccurs="0" fixed="0"/>
  </xs:choice></xs:restriction></xs:complexContent></xs:complexType>
  <xs:complexType name="Heads"><xs:complexContent><xs:restriction base="xs:anyType"><xs:choice>
    <xs:element ref="t:h1"/><xs:element ref="t:h2"/>
  </xs:choice></xs:restriction></xs:complexContent></xs:complexType>
  <xs:complexType name="RootA"><xs:complexContent><xs:restriction base="xs:anyType"/></xs:complexContent></xs:complexType>
  <xs:complexType name="RootR"><xs:complexContent><xs:restriction base="t:RootA"/></xs:complexContent></xs:complexType>
  <xs:complexType name="RootB"><xs:complexContent><xs:extension base="t:RootA"/></xs:complexContent></xs:complexType>
  <xs:complexType name="RootD"><xs:complexContent><xs:extension base="t:RootR"/></xs:complexContent></xs:complexType>
</xs:schema>
