<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:recovery:original-simple-properties"
           targetNamespace="urn:recovery:original-simple-properties">
  <xs:include schemaLocation="original-simple-correspondence-independent.xsd"/>
  <xs:notation name="Picture" public="picture"/>
  <xs:simpleType name="Noted"><xs:restriction base="xs:NOTATION"><xs:enumeration value="t:Picture"/></xs:restriction></xs:simpleType>
  <xs:complexType name="MixedBaseOne" mixed="true"><xs:sequence><xs:element name="a" type="xs:string" minOccurs="0"/></xs:sequence></xs:complexType>
  <xs:complexType name="MixedBaseTwo" mixed="true"><xs:sequence><xs:element name="b" type="xs:string" minOccurs="0"/></xs:sequence></xs:complexType>
  <xs:complexType name="MixedOne"><xs:simpleContent><xs:restriction base="t:MixedBaseOne"><xs:simpleType><xs:restriction base="xs:string"/></xs:simpleType></xs:restriction></xs:simpleContent></xs:complexType>
  <xs:complexType name="MixedTwo"><xs:simpleContent><xs:restriction base="t:MixedBaseTwo"><xs:simpleType><xs:restriction base="xs:string"/></xs:simpleType></xs:restriction></xs:simpleContent></xs:complexType>
  <!-- Deliberate local-invalid scalar for exact original failure ownership. -->
  <xs:simpleType name="Bad"><xs:restriction base="xs:string"><xs:minLength value="-1"/></xs:restriction></xs:simpleType>
</xs:schema>
