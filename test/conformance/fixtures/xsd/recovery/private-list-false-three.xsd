<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:private:false:three" xmlns="urn:saved:QName" targetNamespace="urn:private:false:three" elementFormDefault="qualified">
  <xs:simpleType name="Tokens"><xs:union memberTypes="xs:QName xs:boolean"/></xs:simpleType>
  <xs:simpleType name="Batch"><xs:list itemType="t:Tokens"/></xs:simpleType>
  <xs:simpleType name="Allowed"><xs:restriction base="t:Batch"><xs:pattern value="false"/></xs:restriction></xs:simpleType>
  <xs:element name="north" type="t:Allowed" abstract="true"/>
  <xs:element name="east" type="t:Allowed" abstract="true"/>
  <xs:element name="west" type="t:Allowed" abstract="true"/>
