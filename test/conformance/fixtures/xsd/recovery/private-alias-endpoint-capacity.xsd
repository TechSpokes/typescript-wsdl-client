<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:scalar:private-alias-endpoint-capacity" targetNamespace="urn:scalar:private-alias-endpoint-capacity">
  <xs:complexType name="A"/>
  <xs:complexType name="B"><xs:complexContent><xs:extension base="t:A"/></xs:complexContent></xs:complexType>
  <xs:complexType name="R"><xs:complexContent><xs:restriction base="t:A"/></xs:complexContent></xs:complexType>
  <xs:complexType name="D"><xs:complexContent><xs:extension base="t:R"/></xs:complexContent></xs:complexType>
  <xs:simpleType name="DecimalA"><xs:restriction base="xs:decimal"><xs:maxInclusive value="2"/><xs:pattern value="[0-9]+([.][0-9]+)?"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="DecimalB"><xs:restriction base="t:DecimalA"><xs:maxExclusive value="1"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="DurationA"><xs:restriction base="xs:duration"><xs:maxInclusive value="PT2S"/><xs:enumeration value="PT1S"/><xs:enumeration value="PT2S"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="CalendarA"><xs:restriction base="xs:dateTime"><xs:maxInclusive value="2000-01-01T00:00:02Z"/><xs:enumeration value="2000-01-01T00:00:01Z"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="FloatA"><xs:restriction base="xs:float"><xs:maxInclusive value="1"/><xs:enumeration value="0"/><xs:enumeration value="1"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="EmptyFloat"><xs:restriction base="xs:float"><xs:minExclusive value="1"/><xs:enumeration value="2"/><xs:pattern value="a"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="NotBound"><xs:list itemType="xs:decimal"/></xs:simpleType>
  <xs:complexType name="SCB"><xs:simpleContent><xs:extension base="t:DecimalA"/></xs:simpleContent></xs:complexType>
  <xs:complexType name="SCA"><xs:simpleContent><xs:restriction base="t:SCB"><xs:maxExclusive value="1"/></xs:restriction></xs:simpleContent></xs:complexType>
  <xs:complexType name="MixedBase" mixed="true"/>
  <xs:complexType name="MixedScalar"><xs:simpleContent><xs:restriction base="t:MixedBase"><xs:simpleType><xs:restriction base="xs:decimal"/></xs:simpleType><xs:maxInclusive value="2"/></xs:restriction></xs:simpleContent></xs:complexType>
</xs:schema>
