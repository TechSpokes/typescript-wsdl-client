{
  "exactStrings": {
    "type": "object",
    "properties": {
      "int64": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)$"},
      "decimal": {"type": "string", "pattern": "^[+-]?([0-9]+([.][0-9]*)?|[.][0-9]+)$"},
      "witness": {"type": "string", "pattern": "^[+]0[0-9][.][0-9]{2}$"}
    },
    "required": ["int64", "decimal", "witness"],
    "additionalProperties": false
  },
  "nativeNumbers": {
    "type": "object",
    "properties": {"int64": {"type": "integer"}, "decimal": {"type": "number"}},
    "required": ["int64", "decimal"],
    "additionalProperties": false
  },
  "annotationOnly": {
    "type": "object",
    "properties": {"decimal": {"type": "string", "x-xsd-fractionDigits": 2}},
    "required": ["decimal"],
    "additionalProperties": false
  }
}
