        </xs:sequence></xs:complexType></xs:element>
      </xs:sequence></xs:complexType></xs:element>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="Input"><wsdl:part name="parameters" element="tns:Submit"/></wsdl:message>
  <wsdl:message name="Output"><wsdl:part name="parameters" element="tns:SubmitResponse"/></wsdl:message>
  <wsdl:portType name="ProbePortType">
    <wsdl:operation name="Submit"><wsdl:input message="tns:Input"/><wsdl:output message="tns:Output"/></wsdl:operation>
    <wsdl:operation name="StreamSubmit"><wsdl:input message="tns:Input"/><wsdl:output message="tns:Output"/></wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="Soap11" type="tns:ProbePortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
