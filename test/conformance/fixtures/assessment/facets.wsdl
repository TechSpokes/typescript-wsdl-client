  <wsdl:types>
    <xs:schema targetNamespace="urn:checked:forecast" elementFormDefault="qualified">
      <xs:simpleType name="Word"><xs:restriction base="xs:string"><xs:whiteSpace value="collapse"/><xs:minLength value="2"/><xs:pattern value="[A-Z]+[0-9]+"/></xs:restriction></xs:simpleType>
