        <xs:element name="counts" type="t:Counts"/>
        <xs:element name="exacts" type="t:Exacts"/>
        <xs:element name="monies" type="t:Monies"/>
        <xs:element name="intWords" type="t:IntWords"/>
        <xs:element name="listWord" type="t:ListWord"/>
        <xs:element name="choice" type="t:Choice"/>
        <xs:element name="choices" type="t:Choices"/>
        <xs:element name="choiceWord" type="t:ChoiceWord"/>
        <xs:element name="repeated" type="t:Count" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="optional" type="t:Code" minOccurs="0" default="AB12"/>
