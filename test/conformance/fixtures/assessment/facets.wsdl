      <xs:simpleType name="Codes"><xs:list itemType="t:Code"/></xs:simpleType>
      <xs:simpleType name="Pair"><xs:restriction base="t:Codes"><xs:length value="2"/><xs:enumeration value="AB12 AB34"/></xs:restriction></xs:simpleType>
      <xs:simpleType name="Counts"><xs:list itemType="t:Count"/></xs:simpleType>
      <xs:simpleType name="Exacts"><xs:list itemType="t:Exact"/></xs:simpleType>
