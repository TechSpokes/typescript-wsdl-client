        <xs:element name="replace"><xs:simpleType><xs:restriction base="xs:string"><xs:whiteSpace value="replace"/><xs:length value="3"/></xs:restriction></xs:simpleType></xs:element>
        <xs:element name="count" type="t:Count"/>
        <xs:element name="exact" type="t:Exact"/>
        <xs:element name="digits"><xs:simpleType><xs:restriction base="xs:decimal"><xs:totalDigits value="3"/><xs:fractionDigits value="1"/></xs:restriction></xs:simpleType></xs:element>
        <xs:element name="integerDigits"><xs:simpleType><xs:restriction base="xs:integer"><xs:totalDigits value="3"/></xs:restriction></xs:simpleType></xs:element>
