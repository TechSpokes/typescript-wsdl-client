      <xs:simpleType name="Nested"><xs:union xmlns:a="urn:checked:forecast" memberTypes="a:Code"><xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="Z[0-9]+"/></xs:restriction></xs:simpleType></xs:union></xs:simpleType>
