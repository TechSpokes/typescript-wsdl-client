<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
  xmlns:soap12="http://schemas.xmlsoap.org/wsdl/soap12/"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:t="urn:checked:planner-diagnostics"
  xmlns:types="urn:checked:planner-diagnostics:types"
  targetNamespace="urn:checked:planner-diagnostics">
  <wsdl:types>
    <xs:schema targetNamespace="urn:checked:planner-diagnostics" elementFormDefault="qualified">
      <xs:import namespace="urn:checked:planner-diagnostics:types" schemaLocation="types.xsd"/>
      <xs:element name="Request" type="types:RequestValue"/>
      <xs:element name="Response" type="xs:string"/>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="Request"><wsdl:part name="body" element="t:Request"/></wsdl:message>
  <wsdl:message name="Response"><wsdl:part name="body" element="t:Response"/></wsdl:message>
  <wsdl:portType name="ProbeType">
    <wsdl:operation name="Probe"><wsdl:input message="t:Request"/><wsdl:output message="t:Response"/></wsdl:operation>
    <wsdl:operation name="Check"><wsdl:input message="t:Request"/><wsdl:output message="t:Response"/></wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="ProbeBinding" type="t:ProbeType">
    <soap12:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="Probe">
      <soap12:operation soapAction="urn:checked:probe"/>
      <wsdl:input><soap12:body use="literal"/></wsdl:input>
      <wsdl:output><soap12:body use="literal"/></wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="Check">
      <soap12:operation soapAction="urn:checked:check"/>
      <wsdl:input><soap12:body use="literal"/></wsdl:input>
      <wsdl:output><soap12:body use="literal"/></wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
</wsdl:definitions>
