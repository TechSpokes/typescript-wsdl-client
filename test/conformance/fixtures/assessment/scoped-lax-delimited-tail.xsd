<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:checked:scoped-lax"
  targetNamespace="urn:checked:scoped-lax" elementFormDefault="qualified">
  <xs:complexType name="Base">
    <xs:sequence>
      <xs:element name="Name" type="xs:string"/>
      <xs:element name="BaseOption" type="xs:int" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="token" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:element name="ExtraCount" type="xs:int"/>
  <xs:element name="Content">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="t:Base">
          <xs:sequence>
            <xs:element name="RateControl" type="xs:int" minOccurs="0"/>
            <xs:element name="H264" type="xs:string" minOccurs="0"/>
            <xs:element name="SessionTimeout" type="xs:duration"/>
            <xs:any namespace="##any" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
</xs:schema>
