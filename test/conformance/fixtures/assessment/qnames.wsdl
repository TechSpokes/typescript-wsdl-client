<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:s="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:s12="http://schemas.xmlsoap.org/wsdl/soap12/" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:t="urn:owned:qnames" xmlns:d="urn:owned:declaration" targetNamespace="urn:owned:qnames">
  <wsdl:types>
    <xs:schema targetNamespace="urn:owned:qnames" elementFormDefault="qualified">
      <xs:simpleType name="Known"><xs:annotation><xs:documentation>Names declared by the schema.</xs:documentation></xs:annotation><xs:restriction base="xs:QName"><xs:enumeration value="d:Entry"/></xs:restriction></xs:simpleType>
      <xs:simpleType name="QNameList"><xs:list itemType="xs:QName"/></xs:simpleType>
      <xs:simpleType name="QNameOrFlag"><xs:union memberTypes="xs:boolean xs:QName"/></xs:simpleType>
      <xs:simpleType name="QNameOrWord"><xs:union memberTypes="xs:QName xs:string"/></xs:simpleType>
      <xs:simpleType name="QNameChoices"><xs:list itemType="t:QNameOrFlag"/></xs:simpleType>
      <xs:complexType name="NamedText"><xs:simpleContent><xs:extension base="xs:QName">
        <xs:attribute name="code" type="xs:QName" use="required"/>
        <xs:attribute name="seed" type="xs:QName" default="d:Seed"/>
      </xs:extension></xs:simpleContent></xs:complexType>
      <xs:complexType name="Names"><xs:sequence>
        <xs:element name="fixedName" type="t:Known" fixed="d:Entry"><xs:annotation><xs:documentation>Fixed name in this message.</xs:documentation></xs:annotation></xs:element>
        <xs:element name="words" type="t:QNameList"/>
        <xs:element name="text" type="t:NamedText"/>
        <xs:element name="selected" type="t:QNameOrFlag"/>
        <xs:element name="choices" type="t:QNameChoices"/>
        <xs:element name="literal" type="t:QNameOrWord"/>
        <xs:element name="optionalName" type="xs:QName" nillable="true" minOccurs="0"/>
      </xs:sequence></xs:complexType>
      <xs:element name="Exchange" type="t:Names"/>
      <xs:element name="ExchangeResponse" type="t:Names"/>
      <xs:element name="NameFault" type="xs:QName"/>
    </xs:schema>
  </wsdl:types>
  <wsdl:message name="Input"><wsdl:part name="body" element="t:Exchange"/></wsdl:message>
  <wsdl:message name="Output"><wsdl:part name="body" element="t:ExchangeResponse"/></wsdl:message>
  <wsdl:message name="NameError"><wsdl:part name="detail" element="t:NameFault"/></wsdl:message>
  <wsdl:portType name="QNamePortType">
    <wsdl:operation name="Exchange"><wsdl:input message="t:Input"/><wsdl:output message="t:Output"/><wsdl:fault name="NameError" message="t:NameError"/></wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="Soap11" type="t:QNamePortType">
    <s:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="Exchange"><s:operation soapAction="urn:owned:qnames:Exchange"/><wsdl:input><s:body use="literal"/></wsdl:input><wsdl:output><s:body use="literal"/></wsdl:output><wsdl:fault name="NameError"><s:fault name="NameError" use="literal"/></wsdl:fault></wsdl:operation>
  </wsdl:binding>
  <wsdl:binding name="Soap12" type="t:QNamePortType">
    <s12:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="Exchange"><s12:operation soapAction="urn:owned:qnames:Exchange"/><wsdl:input><s12:body use="literal"/></wsdl:input><wsdl:output><s12:body use="literal"/></wsdl:output><wsdl:fault name="NameError"><s12:fault name="NameError" use="literal"/></wsdl:fault></wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="QNameService">
    <wsdl:port name="Port11" binding="t:Soap11"><s:address location="http://127.0.0.1:1/soap11"/></wsdl:port>
    <wsdl:port name="Port12" binding="t:Soap12"><s12:address location="http://127.0.0.1:1/soap12"/></wsdl:port>
  </wsdl:service>
</wsdl:definitions>
